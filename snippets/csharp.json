{
  "OData Controller": {
    "prefix": "odatacontroller",
    "body": [
      "// Read OData basic CRUD tutorial:",
      "// https://learn.microsoft.com/en-us/odata/webapi-8/tutorials/basic-crud",
      "",
      "[PortFilter(Port = ComponentPorts.InternalHttp1)]",
      "[ConfigurationMustBeSet]",
      "public class ${1:$TM_FILENAME_BASE}(",
      "    ${2:DbContext} dbContext,",
      "    ILogger<${1:$TM_FILENAME_BASE}> logger)",
      "    : ODataController",
      "{",
      "",
      "}"
    ],
    "description": "OData Controller"
  },
  "OData Controller - List": {
    "prefix": "odatalist",
    "body": [
      "[EnableQuery(MaxNodeCount = 20)]",
      "public IQueryable<${1:Entity}> Get()",
      "{",
      "    ArgumentNullException.ThrowIfNull(dbContext);",
      "    ",
      "    return dbContext.${2:EntitySet}.AsQueryable();",
      "}"
    ],
    "description": "OData Controller - List"
  },
  "OData Controller - Get": {
    "prefix": "odataget",
    "body": [
      "public async Task<ActionResult<${1:Entity}>> Get([FromRoute] ${2:KeyType} key, CancellationToken cancellationToken)",
      "{",
      "    ArgumentNullException.ThrowIfNull(dbContext);",
      "    ${1:Entity}? entity = await dbContext.${3:EntitySet}.SingleOrDefaultAsync(e => e.Identifier.Equals(key), cancellationToken);",
      "",
      "    if (entity == null)",
      "    {",
      "        logger.LogError(\"${1:Entity} {Key} not found.\", key);",
      "        return this.NotFound();",
      "    }",
      "",
      "    return this.Ok(entity);",
      "}"
    ],
    "description": "OData Controller - Get"
  },
  "OData Controller - Post": {
    "prefix": "odatapost",
    "body": [
      "public async Task<ActionResult> Post([FromBody] ${1:Entity} entity, CancellationToken cancellationToken)",
      "{",
      "    ArgumentNullException.ThrowIfNull(dbContext);",
      "    if (entity is null)",
      "    {",
      "        return this.BadRequest();",
      "    }",
      "    ",
      "    await dbContext.${2:EntitySet}.AddAsync(entity, cancellationToken);",
      "    await dbContext.SaveChangesAsync(cancellationToken);",
      "    ",
      "    logger.LogInformation(\"A new ${1:Entity} has been created.\");",
      "    ",
      "    return this.Created(entity);",
      "}"
    ],
    "description": "OData Controller - Post"
  },
  "OData Controller - Put": {
    "prefix": "odataput",
    "body": [
      "public async Task<ActionResult> Put([FromRoute] ${1:KeyType} key, [FromBody] ${2:Entity} updatedEntity, CancellationToken cancellationToken)",
      "{",
      "    ArgumentNullException.ThrowIfNull(dbContext);",
      "    if (updatedEntity is null)",
      "    {",
      "        return this.BadRequest();",
      "    }",
      "    ",
      "    ${2:Entity}? entity = await dbContext.${3:EntitySet}.SingleOrDefaultAsync(e => e.Identifier.Equals(key), cancellationToken);",
      "",
      "    if (entity == null)",
      "    {",
      "        logger.LogError(\"${2:Entity} {Key} not found.\", key);",
      "        return this.NotFound();",
      "    }",
      "",
      "    // TODO: Update the entity",
      "",
      "    await dbContext.SaveChangesAsync(cancellationToken);",
      "",
      "    logger.LogInformation(\"${2:Entity} {Key} has been updated.\", key);",
      "",
      "    return this.Updated(entity);",
      "}"
    ],
    "description": "OData Controller - Put"
  },
  "OData Controller - Patch": {
    "prefix": "odatapatch",
    "body": [
      "public async Task<ActionResult> Patch([FromRoute] ${1:KeyType} key, [FromBody] Delta<${2:Entity}> delta, CancellationToken cancellationToken)",
      "{",
      "    ArgumentNullException.ThrowIfNull(delta);",
      "    ArgumentNullException.ThrowIfNull(dbContext);",
      "",
      "    delta.UpdatableProperties.Clear();",
      "    // TODO: Add updatable properties",
      "    // delta.UpdatableProperties.Add(nameof(${2:Entity}.MyProperty));",
      "",
      "    ${2:Entity}? entity = await dbContext.${3:EntitySet}.SingleOrDefaultAsync(e => e.Identifier.Equals(key), cancellationToken);",
      "",
      "    if (entity == null)",
      "    {",
      "        logger.LogError(\"${2:Entity} {Key} not found.\", key);",
      "        return this.NotFound();",
      "    }",
      "",
      "    delta.Patch(entity);",
      "",
      "    await dbContext.SaveChangesAsync(cancellationToken);",
      "",
      "    logger.LogInformation(\"${2:Entity} {Key} has been updated.\", key);",
      "",
      "    return this.Updated(entity);",
      "}"
    ],
    "description": "OData Controller - Patch"
  },
  "OData Controller - Delete": {
    "prefix": "odatadelete",
    "body": [
      "public async Task<ActionResult> Delete([FromRoute] ${1:KeyType} key, CancellationToken cancellationToken)",
      "{",
      "    ArgumentNullException.ThrowIfNull(dbContext);",
      "",
      "    await dbContext.${2:EntitySet}",
      "        .Where(e => e.Identifier.Equals(key))",
      "        .ExecuteDeleteAsync(cancellationToken);",
      "",
      "    await dbContext.SaveChangesAsync(cancellationToken);",
      "",
      "    logger.LogInformation(\"${3:Entity} {Key} has been deleted.\", key);",
      "",
      "    return this.NoContent();",
      "}"
    ],
    "description": "OData Controller - Delete"
  }
}
